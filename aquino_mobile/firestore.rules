rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomIdFor(firstUid, secondUid) {
      return firstUid < secondUid
        ? firstUid + '_' + secondUid
        : secondUid + '_' + firstUid;
    }

    match /Users/{uid} {
      // These documents contain only directory/profile fields needed by chat.
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid)
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isSelf(uid);

      match /private/{privateId} {
        allow read: if isSelf(uid) && privateId == 'profile';
        allow create, update: if isSelf(uid) && privateId == 'profile';
        allow delete: if isSelf(uid) && privateId == 'profile';
      }

      match /cart/{cartId} {
        allow read, delete: if isSelf(uid) && cartId == 'current';
        allow create, update: if isSelf(uid)
          && cartId == 'current'
          && request.resource.data.items is list;
      }

      match /orders/{orderId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.userId == uid
          && request.resource.data.products is list
          && request.resource.data.total is number
          && request.resource.data.status == 'completed';
        allow update, delete: if false;
      }
    }

    match /chat_rooms/{roomId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0]
            != request.resource.data.participants[1]
        && roomId == roomIdFor(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function room() {
          return get(
            /databases/$(database)/documents/chat_rooms/$(roomId)
          );
        }

        allow read: if signedIn()
          && request.auth.uid in room().data.participants;
        allow create: if signedIn()
          && request.auth.uid in room().data.participants
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.receiverId in room().data.participants
          && request.resource.data.senderId
              != request.resource.data.receiverId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.status == 'sent';
        allow update: if signedIn()
          && request.auth.uid in room().data.participants
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.text == resource.data.text
          && request.resource.data.timestamp == resource.data.timestamp
          && request.resource.data.status in ['sent', 'delivered', 'seen'];
        allow delete: if false;
      }
    }
  }
}
